
{
  "entities": {
    "RoutineTask": {
      "title": "Routine Task",
      "description": "Represents a scheduled reminder for the patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "Name of the activity (e.g., 'Merendar')" },
        "time": { "type": "string", "description": "Time in HH:mm format" },
        "trackNumber": { "type": "integer", "description": "The audio track index on the SD card" },
        "isActive": { "type": "boolean", "default": true }
      },
      "required": ["id", "title", "time", "trackNumber", "isActive"]
    },
    "DeviceSettings": {
      "title": "Device Settings",
      "description": "General settings for the SafeDay device.",
      "type": "object",
      "properties": {
        "volume": { "type": "integer", "description": "Volume level for the DFPlayer (0-30)" },
        "isMuted": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}/routine/{taskId}": {
      "schema": { "$ref": "#/backend/entities/RoutineTask" },
      "description": "Scheduled activities for the patient managed by the caregiver."
    },
    "/users/{userId}/settings/device": {
      "schema": { "$ref": "#/backend/entities/DeviceSettings" },
      "description": "General device configuration."
    }
  }
}
