rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helper function to check if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Helper function to check if the requested userId matches the authenticated user's UID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Controls access to user profile documents.
     */
    match /users/{userId} {
      allow get, update, delete: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow list: if false; // Do not allow listing of all users
    }

    /**
     * @description Controls access to threshold configuration documents nested under a user.
     */
    match /users/{userId}/thresholdConfigurations/{thresholdConfigurationId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Controls access to the latest sensor data document.
     * Authenticated devices write to this document. Any authenticated user can read it.
     */
    match /sensorData/{sensorDataId} {
      allow get: if isSignedIn();
      // Allow write only for authenticated entities (the device).
      // This is a simplification. In a production system, you might use IoT-specific auth.
      allow write: if isSignedIn();
      allow list: if false;
    }

    /**
     * @description Controls the device pairing process.
     */
    match /devicePairing/{deviceId} {
      /**
       * Allow a device (acting as an authenticated user, even if anonymous) to create
       * a document with a pairing token.
       */
      allow create: if isSignedIn() && request.resource.data.userId == null;

      /**
       * Allow the device to read its own pairing document to check if it has been claimed.
       */
      allow get: if isSignedIn();

      /**
       * Allow an authenticated user to claim a device by updating the userId field
       * from null to their own UID. Prevents overwriting an already-claimed device.
       */
      allow update: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && resource.data.userId == null;
      
      /**
       * Allow a device to delete its own pairing document after successful pairing.
       */
      allow delete: if isSignedIn();
    }
  }
}
