
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Permitir que el dispositivo (con su propio UID) pueda leer la rutina del usuario vinculado
    // Para simplificar el prototipo, permitimos lectura si está autenticado.
    match /users/{ownerId}/routine/{taskId} {
      allow read: if isSignedIn();
    }
    match /users/{ownerId}/settings/device {
      allow read: if isSignedIn();
    }
  }
}
