/**
 * @fileOverview Firestore Security Rules for NeuroSense Dashboard.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for threshold configurations,
 * ensuring that only authenticated users can manage their own settings. The sensor
 * data is write-only for the hardware device.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, with 'userId' matching the Firebase Authentication UID.
 * - /users/{userId}/thresholdConfigurations/{thresholdConfigurationId}: Stores threshold configurations owned by the user.
 * - /sensorData/latest: Stores the most recent sensor data; write-only for the hardware device.
 *
 * Key Security Decisions:
 * - Users can only manage their own threshold configurations.
 * - Listing threshold configurations is restricted to the owning user.
 * - The sensorData collection is write-only.
 *
 * Denormalization for Authorization:
 * - The 'userId' field is present within each ThresholdConfiguration document to
 *   enable simple authorization checks based on request.auth.uid, avoiding the
 *   need for costly 'get()' operations.
 *
 * Structural Segregation:
 * - User-specific data (threshold configurations) is stored in user-specific
 *   subcollections, providing a clear separation of data and simplified security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles.  Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile if the userId matches their auth.uid.
     * @allow (get, update, delete) - Authenticated user can read, update, and delete their own profile if the userId matches their auth.uid.
     * @deny (create, update, delete) - Any other user attempts to modify this user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Secure threshold configurations for each user. Only the owning user can manage their configurations.
     * @path /users/{userId}/thresholdConfigurations/{thresholdConfigurationId}
     * @allow (create) - Authenticated user can create a new configuration for themselves.
     * @allow (get, list, update, delete) - Authenticated user can manage their own configurations.
     * @deny (create, update, delete) - Any other user attempts to modify this user's configurations.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId}/thresholdConfigurations/{thresholdConfigurationId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Restrict sensor data to write-only for the hardware device.
     * @path /sensorData/latest
     * @allow (create, update) - requests must come from a trusted hardware device (implementation specific - replace `true` with actual validation).
     * @deny (get, list, delete) - No one should be able to read or delete the latest sensor data.
     * @principle Restricts read access and enforces write-only access.
     */
    match /sensorData/latest {
      // In a real application, you would replace `true` with logic to verify
      // the request is coming from a trusted hardware device. This might involve
      // checking a secret key or verifying the source IP address.
      allow get: if false;
      allow list: if false;
      allow create: if false; // TODO: Implement authorization for the data source.
      allow update: if false; // TODO: Implement authorization for the data source.
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}