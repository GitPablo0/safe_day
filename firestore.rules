
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Determinar si el usuario está autenticado en la web
    function isSignedIn() {
      return request.auth != null;
    }

    // Reglas para la colección de usuarios
    match /users/{userId} {
      // El cuidador tiene control total sobre sus datos
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Permitimos lectura de la rutina si se conoce el UID (para el ESP32)
      // También permitimos actualizar 'lastCompletedAt' desde el dispositivo
      match /routine/{taskId} {
        allow read: if true; 
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCompletedAt']);
      }
      
      // Ajustes del dispositivo: lectura pública por UID
      match /settings/device {
        allow read: if true;
      }
    }
    
    // Denegar todo lo demás por defecto
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
