rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NEUROSENSE DASHBOARD SECURITY RULES
     *
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict User-Ownership model. Access to data is gated by the 
     * authenticated user's UID, which is embedded directly into the document paths.
     *
     * DATA STRUCTURE:
     * Data is organized hierarchically: /users/{userId} -> devices -> configurations.
     * This structure ensures that a user's data is naturally partitioned and easily 
     * secured via path-based wildcards.
     *
     * KEY SECURITY DECISIONS:
     * 1. No Public Access: All read and write operations require authentication.
     * 2. Path-Based Scoping: Users can only list or get documents within their own /users/{userId} tree.
     * 3. Denormalization for Authorization: To maintain high performance and avoid costly 
     *    cross-document lookups (get() calls), ownership fields (userId) and relational 
     *    links (deviceId) are required to be stored directly on child documents.
     * 4. Structural Segregation: All collections are private by default. There are no 
     *    shared or public collections in this current iteration.
     *
     * PROTOTYPING MODE:
     * These rules prioritize strict authorization (who can access) while remaining flexible 
     * on the specific data schema (what is stored) to facilitate rapid development.
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated with Firebase Auth. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks ownership and ensures the document exists for state-changing operations. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for UserProfile documents. Restricts access to the profile owner.
     * @path /users/{userId}
     * @allow (create) User 'abc' creating a document at /users/abc.
     * @deny (get) User 'abc' attempting to read /users/xyz.
     * @principle Enforces path-based ownership and relational integrity for the root user document.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for individual ESP32 Devices.
       * @path /users/{userId}/devices/{deviceId}
       * @allow (list) User 'abc' querying their own devices collection.
       * @deny (update) User 'abc' trying to change the 'userId' field to 'xyz'.
       * @principle Uses denormalized 'userId' field to verify ownership and ensure data consistency.
       */
      match /devices/{deviceId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        /**
         * @description Rules for Device Configurations (thresholds, intervals, etc.).
         * @path /users/{userId}/devices/{deviceId}/configurations/{configurationId}
         * @allow (create) User 'abc' adding a config to their device 'dev123'.
         * @deny (create) User 'abc' adding a config where 'deviceId' in data doesn't match the path.
         * @principle Ensures deep relational integrity by validating both owner and parent device links.
         */
        match /configurations/{configurationId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.deviceId == deviceId;
          allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId && request.resource.data.deviceId == resource.data.deviceId;
          allow delete: if isExistingOwner(userId);
        }
      }
    }

    // Explicitly deny access to any other collections or paths not defined above.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}