/**
 * @description This ruleset enforces a strict user-ownership model for threshold configurations and restricts sensor data writes to a service account (simulated here with isSignedIn()).
 * @dataStructure
 *  - /users/{userId}: Stores user profiles, with 'userId' matching the Firebase Auth UID.
 *  - /users/{userId}/thresholdConfigurations/{thresholdConfigurationId}: Stores threshold configurations owned by the user.
 *  - /sensorData/latest: Stores the most recent sensor data, writable only by authenticated users (simulating device).
 * @keySecurityDecisions
 *  - Users can only access their own profile data.
 *  - Users can only manage their own threshold configurations.
 *  - Only authenticated users can update the sensor data.
 * @denormalizationForAuthorization The userId is stored in the ThresholdConfiguration documents to allow ownership checks without additional reads.
 * @structuralSegregation User-specific data (threshold configurations) is stored under the /users/{userId} path, ensuring clear ownership and simplified list operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile document at /users/user123.
     * @deny (create) User with UID 'user123' cannot create a profile document at /users/anotherUser.
     * @allow (get) User with UID 'user123' can read their profile document at /users/user123.
     * @deny (get) User with UID 'user123' cannot read another user's profile document at /users/anotherUser.
     * @allow (update) User with UID 'user123' can update their profile document at /users/user123.
     * @deny (update) User with UID 'user123' cannot update another user's profile document at /users/anotherUser.
     * @allow (delete) User with UID 'user123' can delete their profile document at /users/user123.
     * @deny (delete) User with UID 'user123' cannot delete another user's profile document at /users/anotherUser.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Verify identity
      function isSignedIn() {
        return request.auth != null;
      }

      // Check user owns the data
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Ensure the document exists and the user owns it
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Users can only create their own user document
      allow create: if isOwner(userId) && request.resource.data.id == userId;

      // Get (read) user record, but only if signed in and is owner
      allow get: if isSignedIn() && isOwner(userId);

      // List all users - disabled
      allow list: if false;

      // Can update own user record if signed in and is owner
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Can delete own user record if signed in and is owner
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to threshold configuration documents for each user.
     * @path /users/{userId}/thresholdConfigurations/{thresholdConfigurationId}
     * @allow (create) User with UID 'user123' can create a threshold configuration under /users/user123/thresholdConfigurations/{configId}.
     * @deny (create) User with UID 'user123' cannot create a threshold configuration under /users/anotherUser/thresholdConfigurations/{configId}.
     * @allow (get) User with UID 'user123' can read their threshold configuration under /users/user123/thresholdConfigurations/{configId}.
     * @deny (get) User with UID 'user123' cannot read another user's threshold configuration under /users/anotherUser/thresholdConfigurations/{configId}.
     * @allow (update) User with UID 'user123' can update their threshold configuration under /users/user123/thresholdConfigurations/{configId}.
     * @deny (update) User with UID 'user123' cannot update another user's threshold configuration under /users/anotherUser/thresholdConfigurations/{configId}.
     * @allow (delete) User with UID 'user123' can delete their threshold configuration under /users/user123/thresholdConfigurations/{configId}.
     * @deny (delete) User with UID 'user123' cannot delete another user's threshold configuration under /users/anotherUser/thresholdConfigurations/{configId}.
     * @principle Enforces document ownership and ensures that configurations are only accessible to their owners.
     */
    match /users/{userId}/thresholdConfigurations/{thresholdConfigurationId} {
      // Verify identity
      function isSignedIn() {
        return request.auth != null;
      }

      // Check user owns the data
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Ensure the document exists and the user owns it
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow a user to create a configuration if they are the owner
      allow create: if isOwner(userId) && request.resource.data.userId == userId;

      // Allow a user to read a configuration if they are the owner
      allow get: if isSignedIn() && isOwner(userId);

      // Allow a user to list configurations if they are the owner
      allow list: if isSignedIn() && isOwner(userId);

      // Allow a user to update a configuration if they are the owner
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;

      // Allow a user to delete a configuration if they are the owner and the record exists
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to the latest sensor data document.
     * @path /sensorData/latest
     * @allow (get) Any user can read the latest sensor data.
     * @deny (create) No one can create the /sensorData/latest document (it should only be updated).
     * @allow (update) Only authenticated users can update the sensor data (simulating device).
     * @deny (delete) No one can delete the sensor data.
     * @principle Allows public read access while restricting write access to authenticated users.
     */
    match /sensorData/latest {
      // Verify identity
      function isSignedIn() {
        return request.auth != null;
      }

      // Allow anyone to read the sensor data
      allow get, list: if true;

      // Only allow signed in users to update the sensor data
      allow create: if false;
      allow update: if isSignedIn() && resource != null;
      allow delete: if false;
    }
  }
}