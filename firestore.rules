/**
 * @fileoverview Firestore Security Rules for NeuroSense Dashboard.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for threshold configurations,
 * ensuring only the authenticated user can manage their own settings.
 * Real-time sensor data is handled separately with write-only access granted to the hardware device.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, with 'userId' matching the Firebase Auth UID.
 * - /users/{userId}/thresholdConfigurations/{thresholdConfigurationId}: Stores user-specific threshold configurations.
 * - /sensorData/latest: Stores the most recent sensor data (temperature, humidity, sound level).
 *
 * Key Security Decisions:
 * - User listing is implicitly denied.
 * - Sensor data updates are write-only, intended for the hardware device.  Authentication mechanism for the hardware is TBD and should be implemented with extreme care.
 * - The 'userId' field is duplicated in the ThresholdConfiguration documents to maintain authorization independence.
 * - No data validation is enforced beyond ownership checks to allow for rapid schema iteration during prototyping.
 *
 * Denormalization for Authorization:
 * - The `ThresholdConfiguration` entity contains a `userId` field, which duplicates the `userId` from the document path.
 *   This allows the rules to quickly verify ownership without needing to perform a `get()` request on the `/users/{userId}` document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User 'm303JtbjMINOG3JSgzU2tAbgfC13' can create their own profile with matching user ID.
     * @deny (create) User 'm303JtbjMINOG3JSgzU2tAbgfC13' cannot create a profile with a different user ID.
     * @allow (get, list) User 'm303JtbjMINOG3JSgzU2tAbgfC13' can read their profile data.
     * @deny (update, delete) Only the owner can update or delete a user profile.
     * @principle Enforces document ownership and prevents unauthorized profile modification.
     */
    match /users/{userId} {
      //Utility function
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Secure access to user-specific threshold configurations.
     * @path /users/{userId}/thresholdConfigurations/{thresholdConfigurationId}
     * @allow (create) User 'm303JtbjMINOG3JSgzU2tAbgfC13' can create a configuration if userId matches.
     * @deny (create) User 'm303JtbjMINOG3JSgzU2tAbgfC13' cannot create a configuration for another user.
     * @allow (get, list) User 'm303JtbjMINOG3JSgzU2tAbgfC13' can read their configurations.
     * @deny (update, delete) Only the owner can update or delete their configurations.
     * @principle Enforces strict user ownership for threshold configurations.
     */
    match /users/{userId}/thresholdConfigurations/{thresholdConfigurationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Restrict write access to sensor data to the hardware device.
     * @path /sensorData/latest
     * @allow (create, update) The hardware device can write sensor data. (Authentication details TBD)
     * @deny (get, list, delete) No client should be able to get, list or delete sensor data.
     * @principle Limits data modification to the intended source (hardware) only.
     */
    match /sensorData/latest {
        //Hardware device writes only. Authentication mechanism is TBD
        //TODO: Add hardware authentication.  This rule is currently insecure
        allow get: if false;
        allow list: if false;
        allow create: if true;
        allow update: if true;
        allow delete: if false;
    }
  }
}