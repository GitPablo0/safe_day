rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permite la lectura y escritura en el documento de estado de la alarma
    // solo si el usuario está autenticado.
    match /alarm/state {
      allow read, write: if request.auth != null;
    }
    
    // Regla de denegación por defecto para cualquier otro documento
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    