rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES - PROTOTYPING PHASE
     * 
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict Path-Based Ownership model. Access to data is 
     * primarily determined by the hierarchical structure of the database, where 
     * user-specific data is nested under their unique authenticated UID.
     * 
     * DATA STRUCTURE:
     * - /users/{userId}: The root document for a user's profile.
     * - /users/{userId}/sensorConfigurations/{configId}: User-specific sensor settings.
     * 
     * KEY SECURITY DECISIONS:
     * 1. Authorization Independence: We rely on the {userId} wildcard in the document 
     *    path to verify ownership, avoiding expensive get() calls to parent documents.
     * 2. QAP Compliance: List operations are restricted to the user's own subcollections, 
     *    ensuring that queries naturally only return data the user is authorized to see.
     * 3. Schema Flexibility: While authorization is strictly enforced (who can write), 
     *    the internal shape of the data is not validated to allow for rapid UI/UX iteration.
     * 4. Relational Integrity: We enforce consistency between the document ID in the path 
     *    and the 'id' field within the document data during creation and updates.
     */

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Combines ownership check with an existence check for updates and deletes. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the user profile document.
     * @path /users/{userId}
     * @allow (get) If auth.uid matches {userId}.
     * @deny (list) If auth.uid does not match {userId} (prevents user discovery).
     * @principle Path-based ownership for private user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for sensor configurations owned by a user.
       * @path /users/{userId}/sensorConfigurations/{configId}
       * @allow (create) If auth.uid matches {userId} and data.id matches {configId}.
       * @deny (update) If the configuration 'id' is being changed to a different value.
       * @principle Relational integrity and owner-only subcollection access.
       */
      match /sensorConfigurations/{configId} {
        allow get, list: if isOwner(userId);
        
        // Ensure the ID in the document matches the ID in the path for relational integrity.
        allow create: if isOwner(userId) && request.resource.data.id == configId;
        
        // Ensure the ID is immutable and the document exists.
        allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
        
        allow delete: if isExistingOwner(userId);
      }
    }

    // --- GLOBAL DENY ---
    // Explicitly deny access to any other paths not defined above.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}