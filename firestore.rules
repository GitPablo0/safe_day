/**
 * FIRESTORE SECURITY RULES
 * 
 * CORE PHILOSOPHY:
 * This ruleset enforces a strict user-ownership model designed for the NeuroSense device ecosystem.
 * Security is rooted in the path structure, ensuring that users can only access and modify
 * their own device configurations.
 * 
 * DATA STRUCTURE:
 * The primary data hierarchy is user-centric: /users/{userId}/deviceConfiguration/{configId}.
 * This structure leverages Firestore's path-based authorization to provide high performance
 * and clear isolation between user data.
 * 
 * KEY SECURITY DECISIONS:
 * 1. Authorization Independence: By including the {userId} in the document path, we eliminate 
 *    the need for cross-document lookups (get() calls), making rules faster and more reliable.
 * 2. Structural Segregation: Device configurations are stored in private subcollections 
 *    belonging to specific users. There are no public or shared configuration paths.
 * 3. Prototyping Flexibility: While authorization is strictly enforced (who can access what), 
 *    the specific schema of the configuration data is not enforced to allow for rapid 
 *    hardware/firmware iteration without rule changes.
 * 
 * DENORMALIZATION FOR AUTHORIZATION:
 * The system uses path-based denormalization. The owner's identity is encoded directly 
 * into the URI of the resource, allowing for O(1) authorization checks using 
 * the 'isOwner' helper function.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    /**
     * @description Checks if the request is made by an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Combines ownership check with a check for the document's existence.
     * Used for update and delete operations to ensure state-changing requests are valid.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the root user document. 
     * @path /users/{userId}
     * @allow Authenticated user (userId) can create and manage their own profile document.
     * @deny Any user attempting to access or create a profile for a different UID.
     * @principle Ownership-based access control.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isExistingOwner(userId);

      /**
       * @description Rules for device configurations (e.g., sound thresholds, LED timings).
       * @path /users/{userId}/deviceConfiguration/{configId}
       * @allow User (userId) can create/read/update/delete their 'default' configuration.
       * @deny Unauthenticated users or users attempting to read/write another user's config.
       * @principle Relational integrity and path-based authorization.
       */
      match /deviceConfiguration/{configId} {
        allow get, list: if isOwner(userId);
        
        // On Create: Ensure the user is the owner and the internal ID matches the document ID for consistency.
        allow create: if isOwner(userId) && request.resource.data.id == configId;
        
        // On Update: Ensure the document exists, user is owner, and the internal ID remains immutable.
        allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
        
        allow delete: if isExistingOwner(userId);
      }
    }
    
    // Default deny for any paths not explicitly matched above.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}