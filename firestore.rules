rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permite la lectura y escritura en el documento de estado de la alarma.
    // NOTA: Esta regla es abierta para facilitar la conexión inicial del dispositivo.
    // Se recomienda ajustarla a reglas más seguras una vez que la conexión funcione.
    match /alarm/state {
      allow read, write: if true;
    }
    
    // Regla de denegación por defecto para cualquier otro documento
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
